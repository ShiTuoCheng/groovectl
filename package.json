{
  "name": "groovectl",
  "version": "0.1.1",
  "description": "A script-friendly Discogs CLI for exploring releases, managing your collection and wantlist, and reading Marketplace data.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShiTuoCheng/groovectl.git"
  },
  "homepage": "https://github.com/ShiTuoCheng/groovectl#readme",
  "bugs": {
    "url": "https://github.com/ShiTuoCheng/groovectl/issues"
  },
  "keywords": [
    "discogs",
    "cli",
    "vinyl",
    "collection",
    "wantlist",
    "marketplace"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "groovectl": "dist/bin/groovectl.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=module --eval \"import { chmodSync } from 'node:fs'; if (process.platform !== 'win32') chmodSync('dist/bin/groovectl.js', 0o755);\"",
    "clean": "node --eval \"import('node:fs/promises').then(({ rm }) => rm('dist', { recursive: true, force: true }))\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "pnpm clean && pnpm build",
    "prepublishOnly": "pnpm release:check",
    "release:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm audit --prod --audit-level high",
    "start": "node dist/bin/groovectl.js",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:package": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@napi-rs/keyring": "^2.1.0",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
